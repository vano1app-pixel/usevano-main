{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(), camera=(self)"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://us.i.posthog.com https://eu.i.posthog.com; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://us.i.posthog.com https://eu.i.posthog.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://maps.googleapis.com https://nominatim.openstreetmap.org https://*.tile.openstreetmap.org https://api.open-meteo.com; frame-src https://js.stripe.com https://checkout.stripe.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(ico|png|jpg|jpeg|svg|webp|avif|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(home|join|find|track|auth|account|bookings|student-dashboard|student-account|student-job|accepted|verify-helper|household-admin|helpers|helper|privacy|terms|cover|safety|helper-terms)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.vanojobs.com"
        }
      ],
      "destination": "https://vanojobs.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/notes",
      "permanent": true
    },
    {
      "source": "/glossary/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/partners",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/refer",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cleaning-galway",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/laundry-galway",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/garden-help-galway",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dog-walking-galway",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/laundry-service-galway",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/moving-help-galway",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/episodes/:slug",
      "destination": "/episodes/:slug/index.html"
    },
    {
      "source": "/notes/:slug",
      "destination": "/notes/:slug/index.html"
    },
    {
      "source": "/episodes",
      "destination": "/episodes/index.html"
    },
    {
      "source": "/clips",
      "destination": "/clips/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/notes",
      "destination": "/notes/index.html"
    },
    {
      "source": "/site-privacy",
      "destination": "/site-privacy/index.html"
    },
    {
      "source": "/site-terms",
      "destination": "/site-terms/index.html"
    },
    {
      "source": "/:section(home|join|find|track|auth|account|bookings|student-dashboard|student-account|student-job|accepted|verify-helper|household-admin|helpers|helper|privacy|terms|cover|safety|helper-terms)/:path*",
      "destination": "/index.html"
    }
  ]
}
