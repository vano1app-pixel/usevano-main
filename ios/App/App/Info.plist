<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>VANO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Location: customers use "use my location" to fill their address; helpers
	     share live location while on the way to a job. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VANO uses your location to fill in your address and to share your live location with the customer while you're on the way to a job.</string>
	<!-- Camera + photo library: helpers add a face/profile photo during sign-up
	     and from their account. The upload uses a file input with
	     capture="environment", which opens the camera — without these strings
	     iOS rejects the app / crashes when the picker is opened. -->
	<key>NSCameraUsageDescription</key>
	<string>VANO uses your camera so you can take a profile photo for your helper account.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VANO lets you choose a profile photo from your library for your helper account.</string>
	<!-- Auth deep link: Supabase redirects the OAuth / magic-link return trip to
	     com.vanojobs.app://auth-callback, which re-opens the app. Handled by the
	     appUrlOpen listener in src/lib/native/initNativeAuth.ts. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.vanojobs.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.vanojobs.app</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
