<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>VANO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance: HTTPS only, no proprietary crypto — exempt. Answers
	     the "Missing Compliance" question on every TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- iPhone-only, portrait-only (App Store pass, 2026-09-05): the booking
	     sheet and forms are built for a phone held upright; landscape and iPad
	     would only give the reviewer a stretched layout to reject. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Location, both sides: customers tap "use my location" to fill their
	     address; helpers see jobs near them on Find jobs and share position on
	     the way to a job. When-in-use only — there is no background mode. No mic
	     or speech strings on purpose: the Speak button is gated off on native. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VANO uses your location only while you’re using the app: as a customer, to fill in your address when you tap “use my location”; as a helper, to show jobs near you and let the customer see you’re on the way. Never in the background.</string>
	<!-- Camera + photo library: helpers add a face/profile photo during sign-up
	     and from their account, and before/after job photos. The upload uses a
	     file input with capture, which opens the camera — without these strings
	     iOS rejects the app / crashes when the picker is opened. -->
	<key>NSCameraUsageDescription</key>
	<string>VANO uses the camera only when you choose to take a profile photo, or add a before/after job photo as a helper.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VANO accesses your photos only when you choose one for your profile or a job photo.</string>
	<!-- Auth deep link: Supabase redirects the OAuth / magic-link return trip to
	     com.vanojobs.app://auth-callback, which re-opens the app. Handled by the
	     appUrlOpen listener in src/lib/native/initNativeAuth.ts. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.vanojobs.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.vanojobs.app</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
